{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    // "@unifiedai/sdk/host-api/ambient" declares the `@unified/host-api` bare
    // specifier (it is externalized at build time and never resolves from
    // node_modules); "bun" covers the bun:test import in tests/.
    "types": ["@unifiedai/sdk/host-api/ambient", "bun"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts", "vite.config.ts"]
}
